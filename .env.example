# Local PostgreSQL / Prisma
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=inventory_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inventory_app:change_me_locally@localhost:5432/inventory_dev?schema=public

# Runtime environment
NODE_ENV=development
API_PORT=3000
BODY_SIZE_LIMIT=100kb
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:3000/api

# Use at least 32 random characters locally. Never commit the real value.
JWT_SECRET=replace_with_at_least_32_random_characters
